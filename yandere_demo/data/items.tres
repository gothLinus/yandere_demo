[gd_resource type="Resource" script_class="ItemCatalog" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/core/item_catalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://scripts/core/item_definition.gd" id="2_def"]

[sub_resource type="Resource" id="Resource_hairpin"]
script = ExtResource("2_def")
id = &"hairpin"
display_name = "Hairpin"
color = Color(0.96, 0.55, 0.72, 1)
intel_card_id = &""

[sub_resource type="Resource" id="Resource_handkerchief"]
script = ExtResource("2_def")
id = &"handkerchief"
display_name = "Handkerchief"
color = Color(0.93, 0.93, 0.98, 1)
intel_card_id = &""

[sub_resource type="Resource" id="Resource_pen"]
script = ExtResource("2_def")
id = &"pen"
