display_name = "Bookmark"
color = Color(0.35, 0.7, 0.5, 1)
intel_card_id = &"intel_favorite_book"

[resource]
script = ExtResource("1_catalog")
items = Array[ExtResource("2_def")]([SubResource("Resource_hairpin"), SubResource("Resource_handkerchief"), SubResource("Resource_pen"), SubResource("Resource_drink_can"), SubResource("Resource_note"), SubResource("Resource_spare_ribbon"), SubResource("Resource_bookmark")])
